PORT=8090

# API URLs — relative paths, proxied by nginx (same-origin, no mixed-content risk).
# These are the URLs the loading-screen module pings and the app API clients use.
VITE_IDENTITY_API_URL=/api/identity
VITE_RXSOFT_API_URL=/api
VITE_APM_API_URL=/api
VITE_EMR_API_URL=/api/emr
VITE_LIS_API_URL=/api/lis
VITE_CONVERSATION_API_URL=/api/conversation
VITE_CONVERSATION_SOCKET_URL=wss://conversation.ehealthwares.com
VITE_COMMUNICATION_API_URL=/api/communication
VITE_CODING_CONCEPT_API_URL=/api/coding
