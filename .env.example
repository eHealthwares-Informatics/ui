# Admin frontend (Vite) — environment contract.
# Copy to .env.local and fill in. Never commit real secrets.
#
# VITE_* values are inlined at BUILD time, not read at runtime. Changing them
# requires a rebuild. Every API URL below falls back to a same-origin path, so
# leaving them unset is valid when nginx proxies /api* to the services.

# ── Core ────────────────────────────────────────────────────
PORT=5173

# ── Service endpoints ───────────────────────────────────────
VITE_RXSOFT_API_URL=/api
VITE_IDENTITY_API_URL=/api/identity
VITE_LIS_API_URL=/api/lis
VITE_CONVERSATION_API_URL=/api/conversation
VITE_COMMUNICATION_API_URL=/api/communication
VITE_CODING_CONCEPT_API_URL=/api/coding
VITE_APM_API_URL=/api
VITE_EMR_API_URL=/api/emr

# ── Social login (empty ids disable the buttons) ────────────
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# ── Payment/redirect origin ─────────────────────────────────
# Overrides the origin used for payment callbacks when testing behind a tunnel.
# Unset in production so the browser origin is used.
VITE_CALLBACK_URL=
